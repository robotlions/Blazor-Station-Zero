<h3>DraggableDesktop</h3>

@code {

}
@page "/draggable-desktop"
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Draggable Desktop</PageTitle>
<SectionContent SectionName="page-title">Draggable Desktop</SectionContent>

<div id="desktop-area" class="desktop-area">

	@if (folderVisible)
	{
		<div id="folder" class="folder" draggable="true" @onclick="ReleaseFromFolder"
			 style="position:absolute; left:@((int)folderLeft)px; top:@((int)folderTop)px; z-index:10;">
			@if (textFileInFolder)
			{
				<!-- Folder containing a file: paper corner sticking up from inside -->
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="68" height="57">
					<rect x="52" y="1" width="34" height="28" rx="1" fill="#f8f8f8" stroke="#aaa" stroke-width="1.5" />
					<path d="M78 1 L86 1 L86 9 Z" fill="#ddd" stroke="#aaa" stroke-width="1" />
					<line x1="57" y1="12" x2="82" y2="12" stroke="#ddd" stroke-width="1.5" stroke-linecap="round" />
					<line x1="57" y1="17" x2="82" y2="17" stroke="#ddd" stroke-width="1.5" stroke-linecap="round" />
					<rect x="1" y="22" width="94" height="57" rx="5" fill="#f0b02b" stroke="#111" stroke-width="2.5" />
					<path d="M1 22 L1 13 Q1 9 5 9 L36 9 Q43 9 46 13 L50 22 Z" fill="#ffd86b" stroke="#111" stroke-width="2.5"
						  stroke-linejoin="round" />
					<rect x="5" y="26" width="86" height="10" rx="2" fill="#fff" opacity="0.18" />
				</svg>
			}
			else
			{
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="68" height="57">
					<rect x="1" y="22" width="94" height="57" rx="5" fill="#f0b02b" stroke="#111" stroke-width="2.5" />
					<path d="M1 22 L1 13 Q1 9 5 9 L36 9 Q43 9 46 13 L50 22 Z" fill="#ffd86b" stroke="#111" stroke-width="2.5"
						  stroke-linejoin="round" />
					<rect x="5" y="26" width="86" height="10" rx="2" fill="#fff" opacity="0.18" />
				</svg>
			}
		</div>
	}

	@if (textFileVisible)
	{
		<div id="text-file" class="text-file" draggable="true" @ondblclick="OpenNotepad"
			 style="position:absolute; left:@((int)textFileLeft)px; top:@((int)textFileTop)px; z-index:10;">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 68" width="56" height="68">
				<path d="M4 2 L40 2 L54 16 L54 66 L4 66 Z" fill="#f8f8f8" stroke="#aaa" stroke-width="1.5"
					  stroke-linejoin="round" />
				<path d="M40 2 L40 16 L54 16 Z" fill="#ddd" stroke="#aaa" stroke-width="1.5" stroke-linejoin="round" />
				<line x1="11" y1="26" x2="46" y2="26" stroke="#ccc" stroke-width="2" stroke-linecap="round" />
				<line x1="11" y1="34" x2="46" y2="34" stroke="#ccc" stroke-width="2" stroke-linecap="round" />
				<line x1="11" y1="42" x2="46" y2="42" stroke="#ccc" stroke-width="2" stroke-linecap="round" />
				<line x1="11" y1="50" x2="34" y2="50" stroke="#ccc" stroke-width="2" stroke-linecap="round" />
			</svg>
		</div>
	}

	@* <div class="status">@statusMessage</div> *@
	<div id="trash-container"
		 class="trash @((!folderVisible || (!textFileVisible && !textFileInFolder)) ? "clickable" : "")"
		 @onclick="ResetAll">
		@if (!folderVisible || (!textFileVisible && !textFileInFolder))
		{
			<!-- Full trash: lid ajar, folder tab peeking out -->
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="56" height="62">
				<path d="M28 22 L28 17 Q28 14 31 14 L46 14 Q51 14 53 17 L56 22 Z" fill="#ffd86b" stroke="#111"
					  stroke-width="1.5" stroke-linejoin="round" />
				<path d="M10 28 L15 82 L65 82 L70 28 Z" fill="#cc3333" stroke="#222" stroke-width="2.5"
					  stroke-linejoin="round" />
				<rect x="4" y="19" width="68" height="9" rx="3" fill="#bb2222" stroke="#222" stroke-width="2"
					  transform="rotate(-6 38 23)" />
				<rect x="24" y="7" width="28" height="9" rx="4" fill="#992222" stroke="#222" stroke-width="2"
					  transform="rotate(-6 38 11)" />
				<line x1="30" y1="35" x2="28" y2="75" stroke="#aa2222" stroke-width="2" />
				<line x1="40" y1="35" x2="40" y2="75" stroke="#aa2222" stroke-width="2" />
				<line x1="50" y1="35" x2="52" y2="75" stroke="#aa2222" stroke-width="2" />
			</svg>
		}
		else
		{
			<!-- Empty trash -->
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="56" height="62">
				<rect x="24" y="4" width="28" height="9" rx="4" fill="#aaa" stroke="#222" stroke-width="2" />
				<rect x="4" y="11" width="68" height="9" rx="3" fill="#ccc" stroke="#222" stroke-width="2" />
				<path d="M10 20 L15 82 L65 82 L70 20 Z" fill="#ddd" stroke="#222" stroke-width="2.5"
					  stroke-linejoin="round" />
				<line x1="30" y1="27" x2="28" y2="75" stroke="#aaa" stroke-width="2" />
				<line x1="40" y1="27" x2="40" y2="75" stroke="#aaa" stroke-width="2" />
				<line x1="50" y1="27" x2="52" y2="75" stroke="#aaa" stroke-width="2" />
			</svg>
		}
	</div>
</div>

@if (notepadOpen)
{
	<div class="notepad-overlay" @onclick="CloseNotepad">
		<div class="notepad-window" @onclick:stopPropagation="true">
			<div class="notepad-titlebar">
				<span>NOTEPAD</span>
				<button class="notepad-close" @onclick="CloseNotepad">✕</button>
			</div>
			<textarea @ref="_notepadRef" class="notepad-content" @bind="notepadContent" @bind:event="oninput"></textarea>
		</div>
	</div>
}

@code {
	private DotNetObjectReference<DraggableDesktop>? objRef;
	private IJSObjectReference? _jsModule;
	private ElementReference _notepadRef;
	private bool notepadOpen = false;
	private bool _focusNotepad = false;
	private string notepadContent = "";
	private bool folderVisible = true;
	private double folderLeft = 12.0;
	private double folderTop = 12.0;
	private bool textFileVisible = true;
	private double textFileLeft = 100.0;
	private double textFileTop = 12.0;
	private bool textFileInFolder = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
			_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/Components/Pages/DraggableDesktop.razor.js");
		}
		if (_jsModule != null && objRef != null)
		{
			await _jsModule.InvokeVoidAsync("registerFolderDrag", objRef);
		}
		if (_focusNotepad)
		{
			_focusNotepad = false;
			try { await _notepadRef.FocusAsync(); } catch { }
		}
	}

	private void OpenNotepad()
	{
		notepadOpen = true;
		_focusNotepad = true;
	}

	private void CloseNotepad() => notepadOpen = false;

	[JSInvokable]
	public Task OnFolderMoved(double left, double top)
	{
		folderLeft = left;
		folderTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnFolderDeleted()
	{
		folderVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileMoved(double left, double top)
	{
		textFileLeft = left;
		textFileTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDeleted()
	{
		textFileVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDroppedInFolder()
	{
		textFileVisible = false;
		textFileInFolder = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	private void ReleaseFromFolder()
	{
		if (!textFileInFolder) return;
		textFileInFolder = false;
		textFileVisible = true;
		textFileLeft = folderLeft + 76;
		textFileTop = folderTop;
	}

	private void ResetAll()
	{
		if (folderVisible && (textFileVisible || textFileInFolder)) return;
		if (!folderVisible) { folderVisible = true; folderLeft = 12.0; folderTop = 12.0; }
		if (!textFileVisible && !textFileInFolder) { textFileVisible = true; textFileLeft = 100.0; textFileTop = 12.0; }
	}

	public async ValueTask DisposeAsync()
	{
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterFolderDrag"); } catch { }
		if (_jsModule != null) await _jsModule.DisposeAsync();
		objRef?.Dispose();
	}
}

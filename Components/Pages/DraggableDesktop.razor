@page "/draggable-desktop"
@inject IJSRuntime JS
@rendermode InteractiveServer

<HeadContent>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
	<style>
			.top-row {
				display: none !important;
			}

			article.container-fluid {
				padding-top: 50px !important;
			}
	</style>
</HeadContent>

<PageTitle>Draggable Desktop</PageTitle>
<SectionContent SectionName="page-title">Draggable Desktop</SectionContent>

<div class="row">
	<div class="desktop-menubar">
		<span class="menu-apple">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 26" width="18" height="20">
				<!-- Monitor bezel -->
				<rect x="0" y="0" width="24" height="18" rx="2" fill="#111" />
				<!-- Screen (white cutout) -->
				<rect x="2" y="2" width="20" height="13" fill="#fff" />
				<!-- Stand stem -->
				<rect x="9" y="18" width="6" height="4" fill="#111" />
				<!-- Base -->
				<rect x="3" y="22" width="18" height="3" rx="1" fill="#111" />
			</svg>
		</span>
		<a href="/" class="menu-link">Home</a>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenLauncher">Applications</button>
	</div>
</div>
<div class="row">
	<div id="desktop-area" class="desktop-area col-12">

		@if (folderVisible)
		{
			<div id="folder" class="folder" draggable="true" @onclick="ReleaseFromFolder"
				 style="position:absolute; left:@((int)folderLeft)px; top:@((int)folderTop)px; z-index:10;">
				@if (textFileInFolder)
				{
					<!-- Folder containing a file: paper corner sticking up from inside -->
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="68" height="57">
						<rect x="49" y="4" width="35" height="26" rx="1.5" fill="#f7f8fb" stroke="#6f7784" stroke-width="1.25" />
						<path d="M76 4 L84 4 L84 12 L76 12 Z" fill="#dde1e8" stroke="#6f7784" stroke-width="1" />
						<line x1="54" y1="14" x2="80" y2="14" stroke="#b8bec8" stroke-width="1.15" />
						<line x1="54" y1="18" x2="80" y2="18" stroke="#b8bec8" stroke-width="1.15" />
						<path d="M4 24 L4 13 Q4 9 8 9 L35 9 Q42 9 46 14 L50 24 Z" fill="#f7d869" stroke="#70757e" stroke-width="2.25" stroke-linejoin="round" />
						<rect x="4" y="24" width="88" height="51" rx="2.5" fill="#f2c546" stroke="#70757e" stroke-width="2.25" />
						<rect x="7" y="27" width="82" height="7" rx="1" fill="#ffe291" opacity="0.95" />
						<line x1="7" y1="35" x2="89" y2="35" stroke="#cfa13c" stroke-width="1.4" opacity="0.85" />
						<line x1="7" y1="68" x2="89" y2="68" stroke="#d6aa41" stroke-width="2" opacity="0.85" />
						<line x1="6" y1="26" x2="6" y2="73" stroke="#fff0bc" stroke-width="1" opacity="0.8" />
					</svg>
				}
				else
				{
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="68" height="57">
						<path d="M4 24 L4 13 Q4 9 8 9 L35 9 Q42 9 46 14 L50 24 Z" fill="#f7d869" stroke="#70757e" stroke-width="2.25" stroke-linejoin="round" />
						<rect x="4" y="24" width="88" height="51" rx="2.5" fill="#f2c546" stroke="#70757e" stroke-width="2.25" />
						<rect x="7" y="27" width="82" height="7" rx="1" fill="#ffe291" opacity="0.95" />
						<line x1="7" y1="35" x2="89" y2="35" stroke="#cfa13c" stroke-width="1.4" opacity="0.85" />
						<line x1="7" y1="68" x2="89" y2="68" stroke="#d6aa41" stroke-width="2" opacity="0.85" />
						<line x1="6" y1="26" x2="6" y2="73" stroke="#fff0bc" stroke-width="1" opacity="0.8" />
					</svg>
				}
			</div>
		}

		@if (textFileVisible)
		{
			<div id="text-file" class="text-file" draggable="true" @ondblclick="OpenNotepad"
				 style="position:absolute; left:@((int)textFileLeft)px; top:@((int)textFileTop)px; z-index:10;">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 68" width="56" height="68">
					<path d="M4 2 L39 2 L53 16 L53 66 L4 66 Z" fill="#f9fafc" stroke="#6f7784" stroke-width="1.75" stroke-linejoin="round" />
					<path d="M39 2 L53 16 L39 16 Z" fill="#dbe0e8" stroke="#6f7784" stroke-width="1.4" stroke-linejoin="round" />
					<rect x="7" y="6" width="29" height="3" fill="#ffffff" opacity="0.7" />
					<rect x="9" y="22" width="10" height="10" rx="1" fill="#e7ebf0" stroke="#8b93a0" stroke-width="1" />
					<rect x="11" y="24" width="6" height="1.5" fill="#a1a9b6" />
					<rect x="11" y="27" width="6" height="1.5" fill="#a1a9b6" />
					<line x1="22" y1="25" x2="46" y2="25" stroke="#aeb6c3" stroke-width="1.5" />
					<line x1="22" y1="30" x2="46" y2="30" stroke="#aeb6c3" stroke-width="1.5" />
					<line x1="9" y1="37" x2="46" y2="37" stroke="#aeb6c3" stroke-width="1.5" />
					<line x1="9" y1="43" x2="46" y2="43" stroke="#aeb6c3" stroke-width="1.5" />
					<line x1="9" y1="49" x2="35" y2="49" stroke="#aeb6c3" stroke-width="1.5" />
					<line x1="6" y1="5" x2="6" y2="63" stroke="#ffffff" stroke-width="1" opacity="0.55" />
				</svg>
			</div>
		}

		@* <div class="status">@statusMessage</div> *@
		<div id="trash-container"
			 class="trash @((!folderVisible || (!textFileVisible && !textFileInFolder)) ? "clickable" : "")"
			 @onclick="ResetAll">
			@if (!folderVisible || (!textFileVisible && !textFileInFolder))
			{
				<!-- Full trash: lid ajar, folder tab peeking out -->
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="56" height="62">
					<rect x="24" y="8" width="28" height="9" rx="4" fill="#c3c8d0" stroke="#6b737f" stroke-width="2" transform="rotate(-6 38 12)" />
					<rect x="8" y="18" width="60" height="10" rx="3" fill="#dde2ea" stroke="#6b737f" stroke-width="2" transform="rotate(-6 38 23)" />
					<path d="M12 28 L14 82 L66 82 L68 28 Z" fill="#e4e8ef" stroke="#6b737f" stroke-width="2.5" stroke-linejoin="round" />
					<line x1="22" y1="30" x2="58" y2="30" stroke="#ffffff" stroke-width="1.5" opacity="0.85" />
					<line x1="30" y1="35" x2="29" y2="75" stroke="#98a1ae" stroke-width="2" />
					<line x1="40" y1="35" x2="40" y2="75" stroke="#98a1ae" stroke-width="2" />
					<line x1="50" y1="35" x2="51" y2="75" stroke="#98a1ae" stroke-width="2" />
					<path d="M27 24 L27 18 Q27 15 31 15 L46 15 Q51 15 53 18 L55 24 Z" fill="#f0d278" stroke="#6b737f" stroke-width="1.5" stroke-linejoin="round" />
					<rect x="25" y="43" width="10" height="14" rx="1" fill="#fbfbfd" stroke="#6b737f" stroke-width="1" transform="rotate(-8 30 50)" />
					<line x1="27" y1="47" x2="33" y2="47" stroke="#d9dee5" stroke-width="1" />
					<rect x="43" y="48" width="9" height="12" rx="1" fill="#fbfbfd" stroke="#6b737f" stroke-width="1" transform="rotate(9 47.5 54)" />
				</svg>
			}
			else
			{
				<!-- Empty trash -->
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="56" height="62">
					<rect x="24" y="4" width="28" height="9" rx="4" fill="#c3c8d0" stroke="#6b737f" stroke-width="2" />
					<rect x="8" y="11" width="60" height="9" rx="3" fill="#dde2ea" stroke="#6b737f" stroke-width="2" />
					<path d="M12 20 L14 82 L66 82 L68 20 Z" fill="#e4e8ef" stroke="#6b737f" stroke-width="2.5"
						  stroke-linejoin="round" />
					<line x1="22" y1="22" x2="58" y2="22" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />
					<line x1="30" y1="27" x2="29" y2="75" stroke="#98a1ae" stroke-width="2" />
					<line x1="40" y1="27" x2="40" y2="75" stroke="#98a1ae" stroke-width="2" />
					<line x1="50" y1="27" x2="51" y2="75" stroke="#98a1ae" stroke-width="2" />
				</svg>
			}
		</div>

		<div id="launcher-window" class="launcher-window draggable-window @(launcherOpen ? string.Empty : "window-hidden")">
			<div id="launcher-titlebar" class="launcher-titlebar draggable-window-handle">
				<span>APPLICATIONS</span>
				<button class="launcher-close" @onclick="CloseLauncher">✕</button>
			</div>
			<div class="launcher-content">
				<a href="/textinput" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
							<rect x="3" y="3" width="26" height="26" rx="2" fill="#f6f8fb" stroke="#6b737f" stroke-width="1.5" />
							<rect x="6" y="6" width="20" height="4" fill="#8aa2d8" />
							<line x1="8" y1="15" x2="24" y2="15" stroke="#5f7dc0" stroke-width="1.5" />
							<line x1="8" y1="19" x2="24" y2="19" stroke="#5f7dc0" stroke-width="1.5" />
							<line x1="8" y1="23" x2="19" y2="23" stroke="#5f7dc0" stroke-width="1.5" />
						</svg>
					</span>
					<span class="launcher-label">TextInput</span>
				</a>
				<a href="/message-generator" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
							<rect x="3" y="4" width="26" height="19" rx="2" fill="#f7f0fd" stroke="#6b737f" stroke-width="1.5" />
							<path d="M10 23 L10 28 L15 23 Z" fill="#f7f0fd" stroke="#6b737f" stroke-width="1.5" stroke-linejoin="round" />
							<line x1="8" y1="10" x2="24" y2="10" stroke="#a06ac8" stroke-width="1.5" />
							<line x1="8" y1="14" x2="22" y2="14" stroke="#a06ac8" stroke-width="1.5" />
							<line x1="8" y1="18" x2="18" y2="18" stroke="#a06ac8" stroke-width="1.5" />
						</svg>
					</span>
					<span class="launcher-label">MessageGenerator</span>
				</a>
				<a href="/weather" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
							<circle cx="10" cy="12" r="3.5" fill="#ffd84f" stroke="#b1892b" stroke-width="1.2" />
							<path d="M11 22 H24 C26.8 22 29 20.2 29 18 C29 15.8 27.2 14 24.8 14 C24.2 11.2 21.8 9 18.8 9 C15.8 9 13.4 11 12.8 13.7 C10 13.8 8 15.7 8 18 C8 20.2 9.9 22 11 22 Z" fill="#eaf3ff" stroke="#6b737f" stroke-width="1.5" stroke-linejoin="round" />
						</svg>
					</span>
					<span class="launcher-label">Weather</span>
				</a>
				<a href="/counter" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
							<rect x="5" y="3" width="22" height="26" rx="2" fill="#e8edf6" stroke="#6b737f" stroke-width="1.5" />
							<rect x="8" y="6" width="16" height="6" fill="#f7f9fc" stroke="#9aa3b1" stroke-width="1" />
							<rect x="8" y="15" width="4" height="4" fill="#7aa8db" />
							<rect x="14" y="15" width="4" height="4" fill="#7aa8db" />
							<rect x="20" y="15" width="4" height="4" fill="#7aa8db" />
							<rect x="8" y="21" width="4" height="4" fill="#7aa8db" />
							<rect x="14" y="21" width="4" height="4" fill="#7aa8db" />
							<rect x="20" y="21" width="4" height="4" fill="#e75d53" stroke="#9c3a33" stroke-width="0.8" />
						</svg>
					</span>
					<span class="launcher-label">Counter</span>
				</a>
			</div>
		</div>

		<div id="notepad-window" class="notepad-window draggable-window @(notepadOpen ? string.Empty : "window-hidden")">
			<div id="notepad-titlebar" class="notepad-titlebar draggable-window-handle">
				<span>NOTEPAD</span>
				<button class="notepad-close" @onclick="CloseNotepad">✕</button>
			</div>
			<textarea @ref="_notepadRef" class="notepad-content" @bind="notepadContent" @bind:event="oninput"></textarea>
		</div>
	</div>
</div>

@code {
	private DotNetObjectReference<DraggableDesktop>? objRef;
	private IJSObjectReference? _jsModule;
	private ElementReference _notepadRef;
	private bool notepadOpen = false;
	private bool _focusNotepad = false;
	private string notepadContent = "";
	private bool launcherOpen = true;
	private bool folderVisible = true;
	private double folderLeft = 12.0;
	private double folderTop = 12.0;
	private bool textFileVisible = true;
	private double textFileLeft = 12.0;
	private double textFileTop = 85.0;
	private bool textFileInFolder = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
			_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/Components/Pages/DraggableDesktop.razor.js");
		}
		if (_jsModule != null && objRef != null)
		{
			await _jsModule.InvokeVoidAsync("registerFolderDrag", objRef);
			await _jsModule.InvokeVoidAsync("registerDesktopWindowDrag");
		}
		if (_focusNotepad)
		{
			_focusNotepad = false;
			try { await _notepadRef.FocusAsync(); } catch { }
		}
	}

	private void OpenNotepad()
	{
		notepadOpen = true;
		_focusNotepad = true;
	}

	private void CloseNotepad() => notepadOpen = false;

	private void CloseLauncher() => launcherOpen = false;

	private void OpenLauncher() => launcherOpen = true;

	[JSInvokable]
	public Task OnFolderMoved(double left, double top)
	{
		folderLeft = left;
		folderTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnFolderDeleted()
	{
		folderVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileMoved(double left, double top)
	{
		textFileLeft = left;
		textFileTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDeleted()
	{
		textFileVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDroppedInFolder()
	{
		textFileVisible = false;
		textFileInFolder = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	private void ReleaseFromFolder()
	{
		if (!textFileInFolder) return;
		textFileInFolder = false;
		textFileVisible = true;
		textFileLeft = folderLeft;
		textFileTop = folderTop + 85;
	}

	private void ResetAll()
	{
		if (folderVisible && (textFileVisible || textFileInFolder)) return;
		if (!folderVisible) { folderVisible = true; folderLeft = 12.0; folderTop = 12.0; }
		if (!textFileVisible && !textFileInFolder) { textFileVisible = true; textFileLeft = 12.0; textFileTop = 85.0; }
	}

	public async ValueTask DisposeAsync()
	{
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterFolderDrag"); } catch { }
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterDesktopWindowDrag"); } catch { }
		if (_jsModule != null) await _jsModule.DisposeAsync();
		objRef?.Dispose();
	}
}

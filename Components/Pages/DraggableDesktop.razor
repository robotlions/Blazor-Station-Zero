<h3>DraggableDesktop</h3>

@code {

}
@page "/draggable-desktop"
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Draggable Desktop</PageTitle>
<SectionContent SectionName="page-title">Draggable Desktop</SectionContent>

<style>
	.desktop-area {
		min-height: 320px;
		background: linear-gradient(180deg, #7fb7ff, #cfeaff);
		position: relative;
		height: 70vh;
		overflow: hidden;
	}

	.folder {
		width: 96px;
		height: 80px;
		user-select: none;
		cursor: grab;
		filter: drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.3));
	}

	.folder.dragging {
		opacity: 0.6;
	}

	.hotspots {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(8, 1fr);
		grid-template-rows: repeat(6, 1fr);
	}

	.hotspot {
		border: 1px dashed rgba(0, 0, 0, 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hotspot.over {
		background: rgba(0, 128, 0, 0.12);
		border-color: green;
	}

	.starting-area {
		position: absolute;
		top: 12px;
		left: 12px;
		z-index: 10;
	}

	.status {
		position: absolute;
		bottom: 130px;
		left: 12px;
		z-index: 10;
		font-family: "Courier New", monospace;
		background: rgba(255, 255, 255, 0.7);
		padding: 4px 8px;
	}

	.trash.clickable {
		cursor: pointer;
	}

	/* Trash container */
	.trash {
		position: absolute;
		right: 24px;
		bottom: 24px;
		width: 80px;
		height: 88px;
		cursor: default;
		filter: drop-shadow(3px 3px 0 rgba(0, 0, 0, 0.3));
		transition: filter 0.15s;
	}

	.trash.over {
		filter: drop-shadow(0 0 10px rgba(220, 0, 0, 0.75));
	}
</style>

<div class="desktop-area">

	<div class="starting-area">
		@if (folderVisible && folderLocation == "start")
		{
			<div id="folder" class="folder" draggable="true">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="96" height="80">
					<rect x="1" y="22" width="94" height="57" rx="5" fill="#f0b02b" stroke="#111" stroke-width="2.5" />
					<path d="M1 22 L1 13 Q1 9 5 9 L36 9 Q43 9 46 13 L50 22 Z" fill="#ffd86b" stroke="#111"
						  stroke-width="2.5" stroke-linejoin="round" />
					<rect x="5" y="26" width="86" height="10" rx="2" fill="#fff" opacity="0.18" />
				</svg>
			</div>
		}
	</div>

	
	<div class="hotspots">
		@for (int row = 0; row < HotspotRows; row++)
		{
			@for (int col = 0; col < HotspotCols; col++)
			{
				var hsId = $"hotspot-{row}-{col}";
				<div @key="hsId" id="@hsId" class="hotspot">
					@if (folderVisible && folderLocation == hsId)
					{
						<div id="folder" class="folder" draggable="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 80" width="96" height="80">
								<rect x="1" y="22" width="94" height="57" rx="5" fill="#f0b02b" stroke="#111" stroke-width="2.5" />
								<path d="M1 22 L1 13 Q1 9 5 9 L36 9 Q43 9 46 13 L50 22 Z" fill="#ffd86b" stroke="#111"
									  stroke-width="2.5" stroke-linejoin="round" />
								<rect x="5" y="26" width="86" height="10" rx="2" fill="#fff" opacity="0.18" />
							</svg>
						</div>
					}
				</div>
			}
		}
	</div>


	@* <div class="status">@statusMessage</div> *@
	<div id="trash-container" class="trash @(!folderVisible ? "clickable" : "")" @onclick="ResetFolder">
		@if (!folderVisible)
		{
			<!-- Full trash: lid ajar, folder tab peeking out -->
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="80" height="88">
				<path d="M28 22 L28 17 Q28 14 31 14 L46 14 Q51 14 53 17 L56 22 Z" fill="#ffd86b" stroke="#111"
					  stroke-width="1.5" stroke-linejoin="round" />
				<path d="M10 28 L15 82 L65 82 L70 28 Z" fill="#cc3333" stroke="#222" stroke-width="2.5"
					  stroke-linejoin="round" />
				<rect x="4" y="19" width="68" height="9" rx="3" fill="#bb2222" stroke="#222" stroke-width="2"
					  transform="rotate(-6 38 23)" />
				<rect x="24" y="7" width="28" height="9" rx="4" fill="#992222" stroke="#222" stroke-width="2"
					  transform="rotate(-6 38 11)" />
				<line x1="30" y1="35" x2="28" y2="75" stroke="#aa2222" stroke-width="2" />
				<line x1="40" y1="35" x2="40" y2="75" stroke="#aa2222" stroke-width="2" />
				<line x1="50" y1="35" x2="52" y2="75" stroke="#aa2222" stroke-width="2" />
			</svg>
		}
		else
		{
			<!-- Empty trash -->
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 88" width="80" height="88">
				<rect x="24" y="4" width="28" height="9" rx="4" fill="#aaa" stroke="#222" stroke-width="2" />
				<rect x="4" y="11" width="68" height="9" rx="3" fill="#ccc" stroke="#222" stroke-width="2" />
				<path d="M10 20 L15 82 L65 82 L70 20 Z" fill="#ddd" stroke="#222" stroke-width="2.5"
					  stroke-linejoin="round" />
				<line x1="30" y1="27" x2="28" y2="75" stroke="#aaa" stroke-width="2" />
				<line x1="40" y1="27" x2="40" y2="75" stroke="#aaa" stroke-width="2" />
				<line x1="50" y1="27" x2="52" y2="75" stroke="#aaa" stroke-width="2" />
			</svg>
		}
	</div>
</div>

<script>
	(function () {
		window._folderDrag = window._folderDrag || {};

		window.registerFolderDrag = function (dotNetRef) {
			// cleanup first
			window.unregisterFolderDrag();

			// attach drag handlers; folder element may be re-rendered by Blazor, so re-query each registration
			function attachFolderHandlers() {
				var folder = document.getElementById('folder');
				if (!folder) return null;

				var onDragStart = function (e) {
					if (e.dataTransfer) e.dataTransfer.setData('text/plain', 'folder');
					folder.classList.add('dragging');
				};
				var onDragEnd = function (e) { folder.classList.remove('dragging'); };

				// remove previous handlers if any
				try { folder.removeEventListener('dragstart', onDragStart); } catch (e) { }
				try { folder.removeEventListener('dragend', onDragEnd); } catch (e) { }

				folder.addEventListener('dragstart', onDragStart);
				folder.addEventListener('dragend', onDragEnd);

				return { el: folder, onDragStart: onDragStart, onDragEnd: onDragEnd };
			}

			var folderHandlers = attachFolderHandlers();

			var hotspots = [];
			document.querySelectorAll('.hotspot').forEach(function (el) {
				var onDragOver = function (ev) { ev.preventDefault(); if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move'; this.classList.add('over'); };
				var onDragLeave = function (ev) { this.classList.remove('over'); };
				var onDrop = function (ev) {
					ev.preventDefault();
					this.classList.remove('over');
					try {
						dotNetRef.invokeMethodAsync('OnFolderDropped', this.id).catch(function () { });
					}
					catch (e) { }
				};

				el.addEventListener('dragover', onDragOver);
				el.addEventListener('dragleave', onDragLeave);
				el.addEventListener('drop', onDrop);

				(function (containerEl) {
					setTimeout(function () {
						var f = containerEl.querySelector('#folder');
						if (f) {
							try {
								if (f.draggable !== true) f.setAttribute('draggable', 'true');
							} catch (e) { }
						}
					}, 50);
				})(el);

				hotspots.push({ el: el, onDragOver: onDragOver, onDragLeave: onDragLeave, onDrop: onDrop });
			});

			// register trash container as a drop target (after hotspots)
			var trash = document.getElementById('trash-container');
			if (trash) {
				var onTrashDragOver = function (ev) { ev.preventDefault(); if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move'; this.classList.add('over'); };
				var onTrashLeave = function (ev) { this.classList.remove('over'); };
				var onTrashDrop = function (ev) {
					ev.preventDefault();
					this.classList.remove('over');
					try {
						// notify Blazor that the folder was dropped in the trash; Blazor will hide it
						dotNetRef.invokeMethodAsync('OnFolderDeleted').catch(function () { });
					} catch (e) { }
				};

				trash.addEventListener('dragover', onTrashDragOver);
				trash.addEventListener('dragleave', onTrashLeave);
				trash.addEventListener('drop', onTrashDrop);

				hotspots.push({ el: trash, onDragOver: onTrashDragOver, onDragLeave: onTrashLeave, onDrop: onTrashDrop });
			}

			window._folderDrag = { /* folder: folder, */ folderHandlers: folderHandlers, hotspots: hotspots, dotNetRef: dotNetRef };
		};


		window.unregisterFolderDrag = function () {
			var state = window._folderDrag;
			if (!state) return;
			try {
				if (state.folderHandlers) {
					try { if (state.folderHandlers.el) state.folderHandlers.el.removeEventListener('dragstart', state.folderHandlers.onDragStart); } catch (e) { }
					try { if (state.folderHandlers.el) state.folderHandlers.el.removeEventListener('dragend', state.folderHandlers.onDragEnd); } catch (e) { }
				}
				if (state.hotspots) {
					state.hotspots.forEach(function (h) {
						h.el.removeEventListener('dragover', h.onDragOver);
						h.el.removeEventListener('dragleave', h.onDragLeave);
						h.el.removeEventListener('drop', h.onDrop);
					});
				}
			} catch (e) { }
			window._folderDrag = {};
		};
	})();
</script>

@code {
	private const int HotspotRows = 6;
	private const int HotspotCols = 8;

	private string statusMessage = "Drag the folder into a hotspot.";
	private DotNetObjectReference<DraggableDesktop>? objRef;
	private bool folderVisible = true;
	private string folderLocation = "start"; // start | hotspot-{row}-{col} | trash

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
		}
		if (objRef != null)
		{
			await JS.InvokeVoidAsync("registerFolderDrag", objRef);
		}
	}

	[JSInvokable]
	public Task OnFolderDropped(string hotspotId)
	{
		statusMessage = $"Folder dropped on: {hotspotId}";
		folderVisible = true;
		folderLocation = hotspotId;
		StateHasChanged();
		// OnAfterRenderAsync will re-register JS handlers once the DOM is updated
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnFolderDeleted()
	{
		statusMessage = "Folder moved to Trash and deleted.";
		folderVisible = false;
		folderLocation = "trash";
		StateHasChanged();
		// OnAfterRenderAsync will re-register JS handlers once the DOM is updated
		return Task.CompletedTask;
	}

	private void ResetFolder()
	{
		if (folderVisible) return;
		statusMessage = "Folder restored to starting position.";
		folderVisible = true;
		folderLocation = "start";
	}

	public void Dispose()
	{
		try { JS.InvokeVoidAsync("unregisterFolderDrag"); } catch { }
		objRef?.Dispose();
	}
}

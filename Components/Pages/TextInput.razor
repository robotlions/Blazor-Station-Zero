@page "/textinput"
@rendermode InteractiveServer
@inject IJSRuntime JsRuntime

<PageTitle>Text Input</PageTitle>
<div class="row">
	<div class="col-md">
		<h3>List of People</h3>
		<ul class="personList">
			@foreach (var person in people)
			{
				<li @onclick="() => SetActivePerson(person)">@person.Name</li>
			}

		</ul>
	</div>
	<div class="col-md">
		@if (activePerson is not null)
		{
			<h3>Active Person</h3>
			<p style="font-style:italic">Click property to edit</p>




			@if (CheckIfActive(nameof(Person.Name)) == false)
			{
				<p class="clickableProperty" @onclick="() => ActivateEdit(nameof(Person.Name))">Name: @activePerson.Name</p>
			}
			else
			{
				<TextInputComponent @bind-ActiveValue="ActiveValue" @bind-IsEditing="isEditing"
									ActivePropertyName="@activePropertyName" />
			}
			@if (CheckIfActive(nameof(Person.Profession)) == false)
			{
				<p class="clickableProperty" @onclick="() => ActivateEdit(nameof(Person.Profession))">Profession:
					@activePerson.Profession</p>
				}
			else
				{
					<TextInputComponent @bind-ActiveValue="ActiveValue" @bind-IsEditing="isEditing"
										ActivePropertyName="@activePropertyName" />
				}
				<div style="display: flex; align-items: center; gap: 10px;">
					<p @onclick="() => ActivateEdit(nameof(Person.KnowsThisMuchIs))" style="margin: 0; cursor: pointer;">Knows
						This Much Is: @activePerson.KnowsThisMuchIs</p>
						<div class="form-check form-switch">
							<input class="form-check-input" type="checkbox" id="knowsThisMuchSwitch"
								   checked="@activePerson.KnowsThisMuchIs"
								   @onchange="@((ChangeEventArgs e) => ToggleBool(nameof(Person.KnowsThisMuchIs)))" />
						</div>
					</div>
				}
		else
				{
					<p>Click on a person, jerk</p>
				}

			</div>

		</div>

		
		

@code {
	[Parameter]
	public bool isEditing { get; set; } = false;
	public string? activePropertyName;
	public string? activeValue;
	private bool isBoolEditing { get; set; } = false;
	private bool activeBoolValue;
	public Person? activePerson = null;

	public string? ActiveValue
	{
		get => activeValue;
		set
		{
			activeValue = value;
			if (string.IsNullOrEmpty(activePropertyName)) return;

			// Use reflection to update the selected property on the person instance
			var prop = typeof(Person).GetProperty(activePropertyName!);
			if (prop != null && prop.CanWrite)
			{
				// Convert to the target type if necessary; properties here are strings so a simple coalesce is fine
				prop.SetValue(activePerson, activeValue ?? string.Empty);
			}
		}
	}


	public class Person
	{
		public string Name { get; set; } = string.Empty;
		public string Profession { get; set; } = string.Empty;
		public Boolean KnowsThisMuchIs { get; set; }
	}

	List<Person> people = new List<Person>{

	new Person { Name = "First Person", Profession = "Jazz Musician", KnowsThisMuchIs = false},
	new Person { Name = "Second Person", Profession = "Snowman Builder", KnowsThisMuchIs = true},
	new Person { Name = "Third Person", Profession = "Professional Yoyoist", KnowsThisMuchIs = true}
	};


	private void ActivateEdit(string propertyName)
	{
		// Toggle editing for the same property, or switch to a different property
		if (activePropertyName == propertyName && isEditing)
		{
			// turn off editing
			activePropertyName = null;
			activeValue = null;
			isBoolEditing = false;
			activeBoolValue = false;
			isEditing = false;
			return;
		}

		activePropertyName = propertyName;
		// seed the activeValue by reading the property value using reflection
		var prop = typeof(Person).GetProperty(propertyName);
		if (prop != null)
		{
			var val = prop.GetValue(activePerson);
			// If the property is a boolean, prepare the checkbox path; otherwise use the text input
			if (prop.PropertyType == typeof(bool) || prop.PropertyType == typeof(Boolean))
			{
				isBoolEditing = true;
				activeBoolValue = val is bool b ? b : false;
				activeValue = null;
			}
			else
			{
				isBoolEditing = false;
				activeValue = val?.ToString();
			}
		}

		isEditing = true;
	}

	private void SetActivePerson(Person person)
	{
		activePerson = person;
	}

	private void ToggleBool(string propertyName)
	{
		var prop = typeof(Person).GetProperty(propertyName);
		if (prop != null && prop.CanWrite && (prop.PropertyType == typeof(bool) || prop.PropertyType == typeof(Boolean)))
		{
			var current = prop.GetValue(activePerson);
			bool val = current is bool b ? b : false;
			prop.SetValue(activePerson, !val);
			// If the boolean is currently being edited, reflect the new value there as well
			activeBoolValue = !val;
			StateHasChanged();
		}
	}

	private bool CheckIfActive(string propertyName)
	{
		if (activePropertyName == propertyName && isEditing)
		{
			return true;
		}
		else return false;
	}

}


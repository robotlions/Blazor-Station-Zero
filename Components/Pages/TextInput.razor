@page "/textinput"
@rendermode InteractiveServer
@inject IJSRuntime JsRuntime




<p style="font-style:italic">Click property to edit</p>



@if (CheckIfActive(nameof(PersonData.Name)) == false)
{
	<p @onclick="() => ActivateEdit(nameof(PersonData.Name))">Name: @person.Name</p>
}
else
{
	<TextInputComponent @bind-ActiveValue="ActiveValue" @bind-IsEditing="isEditing" ActivePropertyName="@activePropertyName" />
}
@if (CheckIfActive(nameof(PersonData.Profession)) == false)
{
	<p @onclick="() => ActivateEdit(nameof(PersonData.Profession))">Profession: @person.Profession</p>
}
else
{
	<div class="input-container">
		<input @bind="ActiveValue" @bind:event="oninput" @onblur="() => isEditing = false" class="form-control" placeholder="@activePropertyName" />
		<button class="btn btn-success" @onclick="() => isEditing = false"><i class="bi bi-check-circle"></i></button>
	</div>
}
<p @onclick="() => ToggleBool(nameof(PersonData.KnowsThisMuchIs))">Knows This Much Is: @person.KnowsThisMuchIs</p>


@code {
	[Parameter]
	public bool isEditing { get; set; } = false;
	public string? activePropertyName;
	public string? activeValue;
	private bool isBoolEditing { get; set; } = false;
	private bool activeBoolValue;

	public string? ActiveValue
	{
		get => activeValue;
		set
		{
			activeValue = value;
			if (string.IsNullOrEmpty(activePropertyName)) return;

			// Use reflection to update the selected property on the person instance
			var prop = typeof(PersonData).GetProperty(activePropertyName!);
			if (prop != null && prop.CanWrite)
			{
				// Convert to the target type if necessary; properties here are strings so a simple coalesce is fine
				prop.SetValue(person, activeValue ?? string.Empty);
			}
		}
	}


	public class PersonData
	{
		public string Name { get; set; } = string.Empty;
		public string Profession { get; set; } = string.Empty;
		public Boolean KnowsThisMuchIs { get; set; }
	}

	PersonData person = new PersonData
	{
		Name = "Chuck Roast",
		Profession = "Blimp Inflator",
		KnowsThisMuchIs = true
	};


	private void ActivateEdit(string propertyName)
	{
		// Toggle editing for the same property, or switch to a different property
		if (activePropertyName == propertyName && isEditing)
		{
			// turn off editing
			activePropertyName = null;
			activeValue = null;
			isBoolEditing = false;
			activeBoolValue = false;
			isEditing = false;
			return;
		}

		activePropertyName = propertyName;
		// seed the activeValue by reading the property value using reflection
		var prop = typeof(PersonData).GetProperty(propertyName);
		if (prop != null)
		{
			var val = prop.GetValue(person);
			// If the property is a boolean, prepare the checkbox path; otherwise use the text input
			if (prop.PropertyType == typeof(bool) || prop.PropertyType == typeof(Boolean))
			{
				isBoolEditing = true;
				activeBoolValue = val is bool b ? b : false;
				activeValue = null;
			}
			else
			{
				isBoolEditing = false;
				activeValue = val?.ToString();
			}
		}

		isEditing = true;
	}

	private void ToggleBool(string propertyName)
	{
		var prop = typeof(PersonData).GetProperty(propertyName);
		if (prop != null && prop.CanWrite && (prop.PropertyType == typeof(bool) || prop.PropertyType == typeof(Boolean)))
		{
			var current = prop.GetValue(person);
			bool val = current is bool b ? b : false;
			prop.SetValue(person, !val);
			// If the boolean is currently being edited, reflect the new value there as well
			if (isEditing && activePropertyName == propertyName)
			{
				activeBoolValue = !val;
			}
			StateHasChanged();
		}
	}

	private bool CheckIfActive(string propertyName)
	{
		if (activePropertyName == propertyName && isEditing)
		{
			return true;
		}
		else return false;
	}

}


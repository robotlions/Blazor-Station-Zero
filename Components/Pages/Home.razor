@page "/"
@rendermode InteractiveServer
@inject Components.Services.UserNameState UserNameState

<PageTitle>Blazor Station Zero</PageTitle>
<SectionContent SectionName="page-title">Home</SectionContent>

<div class="cat-background-image">
    <div class="cat-background-content">

        <InputText id="userNameInput" class="form-control cat-input" type="text" @bind-value="UserNameState.UserName"
                   placeholder="Enter your name" onkeydown="if(event.key === 'Enter'){ this.blur(); }" />
    </div>
</div>

